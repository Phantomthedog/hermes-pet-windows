<!-- Hermes Pet — Dual Mode Window: DEBUG and PET -->
<Window x:Class="HermesPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hermes Pet"
        WindowStyle="None"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        Width="280"
        Height="220"
        WindowStartupLocation="CenterScreen">

    <!-- Main container switches between DEBUG and PET mode -->
    <Grid x:Name="RootGrid">

        <!-- DEBUG MODE panel (shown when PetMode=false) -->
        <Border x:Name="DebugPanel"
                Visibility="Visible"
                BorderBrush="#00FF88"
                BorderThickness="3"
                CornerRadius="8"
                Background="#1E1E1E"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="Hermes Pet — DEBUG MODE"
                           Foreground="#00FF88" FontSize="14" FontWeight="Bold" Margin="0,0,0,8" />

                <Border Grid.Row="1" x:Name="StateBorder"
                        Background="#333333" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock x:Name="StateLabel"
                                   Text="State: idle"
                                   Foreground="#CCCCCC" FontSize="16" FontWeight="Bold"
                                   TextAlignment="Center" />
                        <TextBlock x:Name="ConnectionLabel"
                                   Text=""
                                   Foreground="#888888" FontSize="10"
                                   TextAlignment="Center"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Background="#252525" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                    <TextBlock x:Name="SpeechLabel"
                               Text="Waiting for events..."
                               Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </Border>

                <Grid Grid.Row="3" Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="EventCountLabel"
                               Text="Events: 0"
                               Foreground="#666666" FontSize="10" VerticalAlignment="Center" />
                    <TextBlock x:Name="ModeLabel"
                               Grid.Column="1"
                               Text="DEBUG"
                               Foreground="#666666" FontSize="10" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <!-- PET MODE panel (shown when PetMode=true) -->
        <Border x:Name="PetPanel"
                Visibility="Collapsed"
                CornerRadius="8"
                Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Pet character area -->
                <Border Grid.Row="0"
                        Width="126" Height="126"
                        CornerRadius="63"
                        HorizontalAlignment="Center"
                        Margin="0,6,0,6">
                    <Grid Width="108" Height="108">
                        <Image x:Name="PetSpriteImage"
                               Width="108" Height="108"
                               Visibility="Collapsed"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="Fant" />
                        <Canvas x:Name="PetCanvas" Width="108" Height="108"
                                Visibility="Visible"
                                ClipToBounds="True" />
                    </Grid>
                </Border>

                <!-- Speech / state bar -->
                <Border Grid.Row="1"
                        Background="#AA1A1A1A"
                        CornerRadius="4"
                        Padding="6,3"
                        Margin="0,4,0,0"
                        MinHeight="22">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PetSpeechLabel"
                                   Text=""
                                   Foreground="#AAAAAA" FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Ellipse x:Name="PetConnectionDot"
                                     Width="6" Height="6"
                                     Fill="#555555"
                                     Margin="0,0,4,0"
                                     VerticalAlignment="Center" />
                            <TextBlock x:Name="PetDebugOverlay"
                                       Text=""
                                       Foreground="#555555" FontSize="9"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
