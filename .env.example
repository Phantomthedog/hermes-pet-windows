# Hermes Pet — environment variables (optional)
# Copy to .env and customize to override defaults.

# Hermes profile to watch (default: phantom)
# HERMES_PROFILE=phantom

# Bridge watcher port (default: 5731)
# HERMES_PET_PORT=5731

# Poll interval in seconds (default: 1.0)
# HERMES_PET_POLL_INTERVAL=1.0

# Heartbeat interval in seconds (default: 5.0)
# HERMES_PET_HEARTBEAT_INTERVAL=5.0

# Live-state freshness window in seconds (default: 30)
# HERMES_PET_LIVE_FRESHNESS=30

# WSL project root path (auto-detected if not set)
# HERMES_PET_WSL_PROJECT_DIR=/mnt/c/Users/YourName/hermes-pet

# Hermes state.db path (auto-detected from HERMES_PROFILE if not set)
# HERMES_PET_STATE_DB=

# Windows log directory (auto-detected from exe location if not set)
# HERMES_PET_LOG_DIR=
